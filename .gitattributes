# Normalize line endings: LF in the repository and in the working tree.
# Shell scripts and Docker files must stay LF to run inside Linux containers.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
