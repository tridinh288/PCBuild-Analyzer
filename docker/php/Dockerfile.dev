# Local development image for the Laravel API.
# The source code is bind-mounted from ./backend; nothing is copied in.
FROM php:8.3-cli

COPY --from=mlocati/php-extension-installer:2 /usr/bin/install-php-extensions /usr/local/bin/
# pcov: code coverage for the test report (php artisan test --coverage).
RUN install-php-extensions pdo_mysql bcmath intl zip pcov

COPY docker-php-dev.ini /usr/local/etc/php/conf.d/zz-dev.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

EXPOSE 8000
# vendor/ lives in a named volume (see docker-compose.yml), which starts empty on a fresh
# clone and would leave artisan without an autoloader. Installing here keeps `docker compose
# up -d` as the single start command instead of a documented two-step dance.
CMD ["sh", "-c", "[ -f vendor/autoload.php ] || composer install --no-interaction --no-progress; exec php artisan serve --host=0.0.0.0 --port=8000"]
