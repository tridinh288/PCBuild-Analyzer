APP_NAME="PCBuild Analyzer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# React app origin, used for CORS (Phase 4)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: MySQL container from docker-compose.yml (host "mysql" inside Docker).
# Production (TiDB Cloud): port 4000 and MYSQL_ATTR_SSL_CA (D-021).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pcbuild
DB_USERNAME=pcbuild
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

# Stateless API: no sessions, no queue workers
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Cloudinary (D-022), format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Single admin account seeded by AdminSeeder (D-023)
ADMIN_EMAIL=
ADMIN_PASSWORD=
